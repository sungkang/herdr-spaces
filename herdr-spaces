#!/usr/bin/env python3
"""herdr-spaces — tmux-sessionizer, but for herdr-app.

Reads a small TOML config listing project folders, shows an fzf picker to
search/filter them, and on <enter> either shows the matching herdr-app
space if one is already open, or creates a new one rooted at that folder.

Bind it to a key in ~/.config/herdr-app/keys.json (see README), e.g. under
"global":
    "ctrl-s f": {"command": "pane.split",
                 "args": {"direction": "down", "argv": ["herdr-spaces"]}}

Config (default ~/.config/herdr-spaces/config.toml, or $HERDR_SPACES_CONFIG,
or --config PATH):

    # project folders. A path ending in "/*" fans out: the directories below
    # it become candidates. A plain path is offered as-is (the folder itself).
    folders = ["~/dev/me/*", "~/dev/ai/*", "~/dev/work/*", "~/.config/herdr"]

    folder_depth = 1              # dirs at exactly this depth below a "/*" path
    include_hidden = false        # include dot-directories when fanning
    include_open_workspaces = true# also list currently-open spaces
    label_style = "name"          # "name" or "parent-name" for new spaces
"""

from __future__ import annotations

import argparse
import json
import os
import shlex
import subprocess
import sys
import tomllib
from pathlib import Path

DEFAULT_CONFIG = Path(
    os.environ.get("HERDR_SPACES_CONFIG")
    or Path(
        os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")
    ) / "herdr-spaces" / "config.toml"
)

TAB = "\t"

# Printed by --default-config; keep in sync with config.example.toml.
DEFAULT_CONFIG_TEMPLATE = """\
# herdr-spaces config
# Save as ~/.config/herdr-spaces/config.toml (or point $HERDR_SPACES_CONFIG at it,
# or pass --config PATH).

# Project folders. A path ending in "/*" fans out: the directories below it
# become candidates — like `find <dir> -mindepth 1 -maxdepth 1 -type d`.
# A plain path is offered as-is (the folder itself, not its children) —
# handy for a catch-all root or a single standalone project.
# folders = [
#   "~/dev/all-folders-inside-this-folder/*",
#   "~/dev/only-this-folder",
# ]

# How many levels below a "/*" path to collect directories from.
# 1 = immediate children (default). 2 = grandchildren only (e.g. ~/dev/<org>/<repo>).
folder_depth = 1

# Include dot-directories (e.g. .config) when fanning. Default false.
include_hidden = false

# Also list currently-open herdr-app spaces at the top of the picker,
# so you can jump straight to a running one. Default true.
include_open_workspaces = true

# Name used when CREATING a new space, and (after its folder) how "already
# open?" is matched:
#   "name"        -> folder basename            (e.g. "herdr-spaces")
#   "parent-name" -> parent/basename            (e.g. "dev/herdr-spaces")
# Use "parent-name" if you have same-named folders under different roots.
label_style = "name"
"""


def die(msg: str, code: int = 1) -> "None":
    print(f"herdr-spaces: {msg}", file=sys.stderr)
    raise SystemExit(code)


# --------------------------------------------------------------------------- #
# config
# --------------------------------------------------------------------------- #
def load_config(path: Path) -> dict:
    if not path.exists():
        die(
            f"no config at {path}\n"
            f"  create it (see config.example.toml), or set $HERDR_SPACES_CONFIG,\n"
            f"  or pass --config PATH.",
            2,
        )
    try:
        with path.open("rb") as fh:
            cfg = tomllib.load(fh)
    except tomllib.TOMLDecodeError as e:
        die(f"invalid TOML in {path}: {e}")

    if "fan" in cfg or "literal" in cfg or "fan_depth" in cfg:
        die(
            "`fan`/`literal`/`fan_depth` were replaced by `folders`/`folder_depth`:\n"
            '  append "/*" to a path to fan out over its subdirectories,\n'
            "  leave it plain to offer the folder itself."
        )
    cfg.setdefault("folders", [])
    cfg.setdefault("folder_depth", 1)
    cfg.setdefault("include_hidden", False)
    cfg.setdefault("include_open_workspaces", True)
    cfg.setdefault("label_style", "name")
    if cfg["label_style"] not in ("name", "parent-name"):
        die(f'label_style must be "name" or "parent-name", got {cfg["label_style"]!r}')
    if not isinstance(cfg["folders"], list):
        die("`folders` must be an array of directory paths")
    return cfg


def expand(p: str) -> Path:
    return Path(os.path.expandvars(os.path.expanduser(p)))


# --------------------------------------------------------------------------- #
# candidate discovery
# --------------------------------------------------------------------------- #
def dirs_at_depth(root: Path, depth: int, include_hidden: bool) -> list[Path]:
    """Directories exactly `depth` levels below root (depth>=1)."""
    level = [root]
    for _ in range(max(1, depth)):
        nxt: list[Path] = []
        for d in level:
            try:
                for child in d.iterdir():
                    if not child.is_dir():
                        continue
                    if not include_hidden and child.name.startswith("."):
                        continue
                    nxt.append(child)
            except (PermissionError, FileNotFoundError):
                continue
        level = nxt
    return level


def gather_dirs(cfg: dict) -> list[Path]:
    seen: set[str] = set()
    out: list[Path] = []

    def add(p: Path) -> None:
        try:
            rp = p.resolve()
        except (OSError, RuntimeError):
            rp = p
        key = str(rp)
        if key in seen or not p.is_dir():
            return
        seen.add(key)
        out.append(p)

    for raw in cfg["folders"]:
        if raw.endswith("/*"):
            root = expand(raw[:-2])
            if not root.is_dir():
                continue
            for d in dirs_at_depth(root, cfg["folder_depth"], cfg["include_hidden"]):
                add(d)
        else:
            add(expand(raw))

    out.sort(key=lambda p: str(p).lower())
    return out


# --------------------------------------------------------------------------- #
# herdr-app (via the `herdr-app` CLI, which talks to the running window)
# --------------------------------------------------------------------------- #
def herdr_app(*args: str) -> subprocess.CompletedProcess:
    try:
        return subprocess.run(
            ["herdr-app", *args], capture_output=True, text=True
        )
    except FileNotFoundError:
        die("herdr-app not found on PATH")


def list_spaces() -> list[dict]:
    """Open spaces from `herdr-app ls` ({"spaces": [...], "recent": [...]}).

    Each is normalized to {id, name, folder, machine, active}. No window
    running (or unparsable output) means no spaces.
    """
    cp = herdr_app("ls")
    if cp.returncode != 0:
        return []
    try:
        raw = json.loads(cp.stdout).get("spaces") or []
    except (json.JSONDecodeError, AttributeError):
        return []
    out: list[dict] = []
    for sp in raw:
        if not isinstance(sp, dict) or not sp.get("id"):
            continue
        out.append({
            "id": str(sp["id"]),
            "name": str(sp.get("name") or sp["id"]),
            # where its new terminals start; "" means that machine's home
            "folder": str(sp.get("folder") or ""),
            "machine": sp.get("machine") or None,  # None: this computer
            "active": bool(sp.get("active")),
        })
    return out


def label_for(path: Path, style: str) -> str:
    if style == "parent-name" and path.parent.name:
        return f"{path.parent.name}/{path.name}"
    return path.name


def same_dir(a: Path, b: Path) -> bool:
    try:
        return a.resolve() == b.resolve()
    except (OSError, RuntimeError):
        return a == b


def find_space(path: Path, label: str, spaces: list[dict]) -> dict | None:
    """An open local space for this folder: same folder first, else same name."""
    local = [sp for sp in spaces if not sp["machine"]]
    for sp in local:
        if same_dir(expand(sp["folder"] or "~"), path):
            return sp
    return next((sp for sp in local if sp["name"] == label), None)


def home_abbrev(path: Path) -> str:
    s = str(path)
    home = str(Path.home())
    return "~" + s[len(home):] if s == home or s.startswith(home + os.sep) else s


# --------------------------------------------------------------------------- #
# picker
# --------------------------------------------------------------------------- #
def space_where(sp: dict) -> str:
    folder = sp["folder"] or "~"
    if sp["machine"]:
        return f"{sp['machine']}:{folder}"
    return home_abbrev(expand(folder))


def build_rows(cfg: dict, spaces: list[dict]) -> list[tuple[str, str, str]]:
    """Return (display, kind, payload) rows for the picker."""
    rows: list[tuple[str, str, str]] = []
    if cfg["include_open_workspaces"]:
        for sp in spaces:
            mark = "●" if sp["active"] else "○"
            rows.append((f"{mark} {sp['name']}  ({space_where(sp)})", "space", sp["id"]))
    for d in gather_dirs(cfg):
        rows.append((f"  {home_abbrev(d)}", "dir", str(d)))
    return rows


def print_json(cfg: dict) -> None:
    """Folder candidates for the herdr-app modal, which reads open spaces live itself."""
    dirs = []
    for d in gather_dirs(cfg):
        try:
            real = str(d.resolve())
        except (OSError, RuntimeError):
            real = str(d)
        dirs.append({
            "path": str(d),
            "real": real,  # symlinks resolved, for matching a space's folder
            "display": home_abbrev(d),
            "label": label_for(d, cfg["label_style"]),
        })
    json.dump({"include_open_spaces": bool(cfg["include_open_workspaces"]),
               "dirs": dirs}, sys.stdout)
    print()


def run_fzf(rows: list[tuple[str, str, str]]) -> tuple[str, str] | None:
    lines = [TAB.join(r) for r in rows]
    # /bin/ls, not `ls`, so a shell alias (e.g. exa/eza) can't break the preview.
    preview = 'p={3}; if [ -d "$p" ]; then /bin/ls -1p "$p" 2>/dev/null | head -200; else echo "{1}"; fi'
    args = [
        "fzf",
        "--delimiter", TAB,
        "--with-nth", "1",
        "--reverse",
        "--border",
        "--prompt", "space> ",
        "--header", "enter: open/show space   esc: cancel",
        "--preview", preview,
        "--preview-window", "right,50%,border-left",
    ]
    # fzf runs --preview through $SHELL; force POSIX sh so the preview snippet
    # works even when the host shell is fish/nu/etc. (fish rejects `p=...`).
    env = {**os.environ, "SHELL": "/bin/sh"}
    try:
        cp = subprocess.run(args, input="\n".join(lines), text=True,
                            stdout=subprocess.PIPE, env=env)
    except FileNotFoundError:
        die("fzf not found on PATH — install it (brew install fzf)")
    sel = cp.stdout.strip()
    if cp.returncode != 0 or not sel:
        return None  # cancelled
    _display, kind, payload = sel.split(TAB, 2)
    return kind, payload


# --------------------------------------------------------------------------- #
# action
# --------------------------------------------------------------------------- #
def open_or_focus(kind: str, payload: str, cfg: dict, spaces: list[dict],
                  dry_run: bool) -> None:
    if kind == "space":
        return do("space.select", {"id": payload}, dry_run)

    path = Path(payload)
    label = label_for(path, cfg["label_style"])
    existing = find_space(path, label, spaces)
    if existing:
        do("space.select", {"id": existing["id"]}, dry_run)
    else:
        # new spaces are shown immediately; no separate select needed
        do("space.new", {"name": label, "folder": str(path)}, dry_run)


def do(command: str, args: dict, dry_run: bool) -> None:
    # One JSON object rather than `--key value`: herdr-app parses bare values
    # as JSON, so an id or name like "123" would arrive as a number and fail.
    argv = ["herdr-app", "do", command, json.dumps(args)]
    if dry_run:
        print(shlex.join(argv))
        return
    cp = herdr_app(*argv[1:])
    if cp.returncode != 0:
        msg = (cp.stdout or cp.stderr or "").strip()
        try:
            msg = json.loads(msg)["error"]
        except (json.JSONDecodeError, KeyError, TypeError):
            pass
        die(msg or f"herdr-app do {command} failed")


# --------------------------------------------------------------------------- #
# main
# --------------------------------------------------------------------------- #
def main() -> None:
    ap = argparse.ArgumentParser(prog="herdr-spaces", add_help=True,
                                 description="fzf project-folder picker for herdr-app spaces")
    ap.add_argument("--config", type=Path, default=DEFAULT_CONFIG,
                    help=f"config file (default: {DEFAULT_CONFIG})")
    ap.add_argument("--default-config", action="store_true",
                    help="print a default config to stdout and exit")
    ap.add_argument("--list", action="store_true",
                    help="print candidate rows and exit (no fzf, no changes)")
    ap.add_argument("--dry-run", action="store_true",
                    help="pick, but print the herdr-app command instead of running it")
    ap.add_argument("--json", action="store_true",
                    help="print the configured project folders as JSON and exit "
                         "(what the herdr-app modal reads; open spaces not included)")
    args = ap.parse_args()

    if args.default_config:
        print(DEFAULT_CONFIG_TEMPLATE, end="")
        return

    cfg = load_config(args.config)

    if args.json:
        print_json(cfg)
        return
    # Always fetched: also needed to focus (not duplicate) an open space when
    # include_open_workspaces = false.
    spaces = list_spaces()

    if args.list:
        for display, kind, payload in build_rows(cfg, spaces):
            print(f"{kind}\t{payload}\t{display.strip()}")
        return

    rows = build_rows(cfg, spaces)
    if not rows:
        die("no candidates — check `folders` paths in your config")

    picked = run_fzf(rows)
    if picked is None:
        return  # cancelled, quietly
    # space list is fresh enough; re-use what we fetched
    open_or_focus(picked[0], picked[1], cfg, spaces, args.dry_run)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        raise SystemExit(130)
